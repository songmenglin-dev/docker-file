# =============================================================================
# SequoiaDB standalone cluster — environment template
# Copy to .env. DO NOT commit .env.
# =============================================================================

TZ=Asia/Shanghai
# All SequoiaDB node IPs come from the docker compose static IP (172.21.0.10),
# which matches SDB_COORD / SDB_CATALOG / SDB_DATA in docker-compose.yml.
# Override here only if you change the compose subnet.

# Resource caps — read by deploy.resources.limits
SEQUOIADB_MEM_LIMIT=1500M
SEQUOIADB_CPU_LIMIT=2.0