# =============================================================================
# SequoiaDB 3-node distributed cluster — environment template
# Copy to .env. DO NOT commit .env.
# =============================================================================

TZ=Asia/Shanghai

# Per-node resource caps (read by deploy.resources.limits in compose).
# 3 nodes × 1.2 GB = 3.6 GB; leaves ~2.9 GB headroom on the 6.5 GB host.
SEQUOIADB_MEM_LIMIT=1200M
SEQUOIADB_CPU_LIMIT=1.5

# Host port mappings for each node's coord (11810). Choose distinct host ports
# so clients can fail-over to any of the three coord endpoints.
#   <host>:11811 → sdbserver1:11810
#   <host>:11812 → sdbserver2:11810
#   <host>:11813 → sdbserver3:11810
HOST_COORD_PORT_1=11811
HOST_COORD_PORT_2=11812
HOST_COORD_PORT_3=11813

# Inter-node ports (sdbcm 11790, catalog 11800, data 11820) are NOT exposed on
# the host — only on the internal docker network — so changing them requires
# editing docker-compose.yml AND scripts/bootstrap.sh to match.
